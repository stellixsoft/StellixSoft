{
  "mcpServers": {
    "clarity-stellixsoft": {
      "command": "npx",
      "args": ["-y", "@microsoft/clarity-mcp-server"],
      "envFile": "${workspaceFolder}/.env.local"
    },
    "gsc-stellixsoft": {
      "command": "npx",
      "args": ["-y", "suganthan-gsc-mcp"],
      "env": {
        "GSC_AUTH_MODE": "oauth",
        "GSC_OAUTH_SECRETS_FILE": "/Users/primecode/secrets/stellixsoft-gsc-oauth-client.json",
        "GSC_SITE_URL": "https://stellixsoft.com/",
        "GSC_SITE_URLS": "https://stellixsoft.com/",
        "GSC_SCOPES": "readonly"
      }
    }
  }
}
