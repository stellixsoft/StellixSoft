generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @default("")
  content         String
  contentFormat   String   @default("html") // "html" | "markdown"
  date            String
  updatedAt       String?
  readTime        String   @default("5 min read")
  category        String   @default("Enterprise Development")
  tags            String   @default("[]") // JSON array string
  metaTitle       String   @default("")
  metaDescription String   @default("")
  focusKeyword    String   @default("")
  coverImage      String?
  coverImageAlt   String   @default("")
  featured        Boolean  @default(false)
  status          String   @default("draft") // "draft" | "published"
  createdAt       DateTime @default(now())
  modifiedAt      DateTime @updatedAt
}
