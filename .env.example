# App / auth
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string"

# Optional public site URL used in invite emails
NEXT_PUBLIC_SITE_URL="https://stellixsoft.com"

# Firebase client (safe to expose in browser via NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server only — never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email (for contact forms + admin invites + demo-lead API)
# EMAIL_TO=sales@stellixsoft.com
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# RESEND_API_KEY=
# RESEND_FROM=

# Microsoft Clarity Data Export API (Cursor MCP only — local, never commit real token)
# Generate: Clarity project → Settings → Data Export → Generate new API token
# Used by .cursor/mcp.json (clarity-stellixsoft). Limit: 10 requests/day.
CLARITY_API_TOKEN=
