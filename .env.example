# Copy to .env and fill in values. Never commit real secrets.

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string"

# Neon / Vercel Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
